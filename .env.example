# Application Server Environment Configuration
PORT=5000
NODE_ENV=production
LOG_LEVEL=info
SERVICE_NAME=anshil-backend
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL Drizzle ORM)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/anshil_db

# Authentication & CORS Configuration
JWT_SECRET=your-secure-jwt-secret-key
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_SECURE=false
SMTP_FROM="EventRoster Operations <no-reply@eventroster.co.uk>"

# Datadog APM & Observability (Optional - set true when Datadog Agent is deployed)
DATADOG_ENABLED=false
DD_SERVICE=anshil-backend
DD_ENV=production
DD_VERSION=1.0.0

# Initial Seeding Credentials (Only used during npm run db:seed)
SEED_ADMIN_EMAIL=admin@eventroster.co.uk
SEED_ADMIN_PASSWORD=change-me-immediately
SEED_ADMIN_NAME="System Administrator"
